# Supermemory Local (runs in WSL2 as `supermemory-server` on :6767).
# Copy to .env.local and fill in the sm_... token printed on first boot.
SUPERMEMORY_BASE_URL=http://localhost:6767
SUPERMEMORY_API_KEY=sm_xxx

# The container tag Trace scopes all memory under (per-project / per-user namespace).
TRACE_CONTAINER_TAG=trace

# Local LLM used for the borderline "judge" tier and for rationale phrasing.
# Point at Ollama for a fully-offline loop (this is also what you give Supermemory
# Local as OPENAI_BASE_URL so extraction stays on-device).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Local NLI cross-encoder (Xenova/transformers.js). Downloaded once, cached in .models/.
TRACE_NLI_MODEL=Xenova/nli-deberta-v3-small

# Detection thresholds (leave default unless calibrating).
TRACE_TOPIC_GATE=0.4
